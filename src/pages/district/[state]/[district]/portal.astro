                        <text x={padL + i * gw + gw / 2} y={H - 6} text-anchor="middle" class="de-tick">{p.x}</text>
                      </g>
                    ))}
                  </svg>
                  <div class="de-co-mult">{s.series.label}</div>
                  <p class="de-caption" style="margin-top:0.3rem;">{s.series.note} Source: {s.series.source}.</p>
                </div>
              );
            })()}
            <div class="de-story-metrics">
              {s.metrics.map((m: any) => (
                <div class="de-story-metric"><span class="de-sm-l">{m.label}</span><span class="de-sm-v">{m.value}</span></div>
              ))}
            </div>
            <div class="de-story-signif">{s.significance}</div>
            <p class="de-chart-source">{s.source} {deStars(s.confidence)} {s.sourceUrl && <a class="de-src-link" href={s.sourceUrl} target="_blank" rel="noopener">[source]</a>}{s.sourceLinks && s.sourceLinks.map((l: any) => <> <a class="de-src-link" href={l.url} target="_blank" rel="noopener">[{l.label}]</a></>)}</p>
