            {s.series && (() => {
              const pts = s.series.points;
              const maxV = Math.max(...pts.map((p: any) => p.y));
              const n = pts.length;
              const W = 360, H = 150, padL = 8, padT = 24, padB = 24, padR = 8;
              const gw = (W - padL - padR) / n;
              const yy = (v: number) => padT + (1 - v / maxV) * (H - padT - padB);
              return (
                <div class="de-story-chart">
                  <svg viewBox={`0 0 ${W} ${H}`} class="de-svg" role="img" aria-label={`${s.title} ${s.series.label}`}>
                    {[0.25, 0.5, 0.75, 1].map((f) => <line x1={padL} x2={W - padR} y1={yy(maxV * f)} y2={yy(maxV * f)} class="de-grid-dash" />)}
                    <line x1={padL} x2={W - padR} y1={yy(0)} y2={yy(0)} class="de-axis-line" />
                    {pts.map((p: any, i: number) => (
                      <g>
                        <rect x={padL + i * gw + gw * 0.16} y={yy(p.y)} width={gw * 0.68} height={yy(0) - yy(p.y)} rx="4" fill={i === n - 1 ? '#4C72B0' : '#b9cce6'} />
